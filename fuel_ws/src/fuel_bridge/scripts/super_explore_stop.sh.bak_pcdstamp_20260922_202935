#!/bin/bash
# ============================================================
#  一键关闭: SUPER + FUEL + 目标仲裁器 + MAVROS + FAST-LIVO2 + 仿真桥 + PX4 + RViz
#           （super_explore_all.sh 的配套停止脚本）
#
#  默认: 保留 ROS master（常驻，重启只需几秒）
#        FAST-LIVO2 用 SIGINT 关闭 → 若启动时【参数1=1】(PCD_SAVE=1) 会保存 PCD
#
#  --all      : 连 ROS master 一起停
#  --no-save  : FAST-LIVO2 用 SIGKILL（不等保存、更干脆）
#  --keep-px4 : 不停 PX4（下次联调省去重编译启动等待）
#  --keep-mavros : 不停 MAVROS（配合 --keep-px4）
#  --print-params : 只打印解析结果并退出（不关任何东西）
#
#  用法: bash ~/super_explore_stop.sh [选项]
#  例:   bash ~/super_explore_stop.sh              # 常规关闭，保留 master（PCD 会保存）
#        bash ~/super_explore_stop.sh --all        # 全停（含 master）
#        bash ~/super_explore_stop.sh --no-save    # 不等 PCD，快速关
#        bash ~/super_explore_stop.sh --keep-px4 --keep-mavros   # 只停上层应用
#
#  注意: PCD 只由 FAST-LIVO2 产生，且【必须 SIGINT】才落盘；
#        本脚本默认就走 SIGINT（除非 --no-save）。
# ============================================================
# ROS_MASTER_URI 支持外部覆盖（测试/多实例时有用；默认本机 11311）
export ROS_MASTER_URI=${ROS_MASTER_URI:-http://127.0.0.1:11311}
export ROS_IP=127.0.0.1
source /opt/ros/noetic/setup.bash 2>/dev/null
MASTER_PORT=${ROS_MASTER_URI##*:}      # 从 URI 提取端口，供 --all 精确匹配

ALL=0; NOSAVE=0; KEEPPX4=0; KEEPMAV=0; PRINT_PARAMS=0
for a in "$@"; do
  case "$a" in
    --all)          ALL=1 ;;
    --no-save)      NOSAVE=1 ;;
    --keep-px4)     KEEPPX4=1 ;;
    --keep-mavros)  KEEPMAV=1 ;;
    --print-params) PRINT_PARAMS=1 ;;
    0|1)            : ;;   # 容忍误传 pcd 参数（停止脚本不需要它）
    -*)             : ;;
  esac
done

if [ "$PRINT_PARAMS" = "1" ]; then
  echo "PARAMS all=$ALL no_save=$NOSAVE keep_px4=$KEEPPX4 keep_mavros=$KEEPMAV"
  exit 0
fi

ROOT=~/twin_ws/src/FAST-LIVO2
stopped=""
say(){ echo "[stop] $*"; }
kill_if(){  # kill_if <pattern> <label>
  if pgrep -f "$1" >/dev/null 2>&1; then
    pkill -f "$1" 2>/dev/null
    say "      - $2"
    return 0
  fi
  return 1
}

say "==================== 关闭 ===================="

# ---- 1) SUPER（先停控制输出端，避免残余指令继续发）----
say "[1/8] 停 SUPER（fsm_node + super_to_px4_bridge）..."
kill_if "super_to_px4_bridge" "super_to_px4_bridge"
kill_if "fsm_node"            "fsm_node"
stopped="$stopped SUPER"
sleep 1

# ---- 2) FUEL（探索 + 轨迹 + 桥）----
say "[2/8] 停 FUEL（exploration_node + traj_server + waypoint_generator + 两个桥）..."
pkill -f "roslaunch fuel_bridge" 2>/dev/null
kill_if "exploration_node"    "exploration_node"
kill_if "traj_server"         "traj_server"
kill_if "waypoint_generator"  "waypoint_generator"
kill_if "fuel_ctrl_bridge"    "fuel_ctrl_bridge"
kill_if "fuel_input_bridge"   "fuel_input_bridge"
stopped="$stopped FUEL"
sleep 1

# ---- 3) 目标仲裁器 ----
say "[3/8] 停目标仲裁器（goal_arbiter）..."
kill_if "goal_arbiter" "goal_arbiter"
stopped="$stopped 仲裁器"
sleep 1

# ---- 4) MAVROS（先停它，避免继续和 PX4 通信）----
if [ "$KEEPMAV" = "0" ]; then
  say "[4/8] 停 MAVROS ..."
  pkill -f "roslaunch mavros" 2>/dev/null
  kill_if "mavros_node" "mavros_node"
  stopped="$stopped MAVROS"
  sleep 1
else
  say "[4/8] 保留 MAVROS（--keep-mavros）"
fi

# ---- 5) FAST-LIVO2（SIGINT → 触发 savePCD；不要用 -9）----
say "[5/8] 停 FAST-LIVO2（PCD保存=$([ $NOSAVE -eq 1 ] && echo 关 || echo 开)）..."
if pgrep -f "fastlivo_mapping" >/dev/null 2>&1; then
  if [ $NOSAVE -eq 1 ]; then
    pkill -KILL -f "fastlivo_mapping" 2>/dev/null
    say "      已 SIGKILL（不保存 PCD）"
  else
    pkill -INT -f "fastlivo_mapping" 2>/dev/null
    say "      已发 SIGINT，等它保存 PCD 并退出（最多 25s）..."
    for i in $(seq 1 25); do
      pgrep -f "fastlivo_mapping" >/dev/null 2>&1 || break
      sleep 1
    done
    if pgrep -f "fastlivo_mapping" >/dev/null 2>&1; then
      say "      [!] 25s 未退出，改用 SIGTERM"
      pkill -TERM -f "fastlivo_mapping" 2>/dev/null
    else
      say "      [OK] 已退出"
      if [ -d "$ROOT/Log/pcd" ]; then
        say "      PCD 目录: $ROOT/Log/pcd"
        ls -lh "$ROOT/Log/pcd" 2>/dev/null | grep -E "\.pcd" | tail -3 | sed 's/^/        /'
      fi
    fi
  fi
  stopped="$stopped FAST-LIVO2"
else
  say "      （未在跑）"
fi

# ---- 6) 仿真桥 + RViz ----
say "[6/8] 停仿真桥 + RViz ..."
pkill -f "roslaunch twin_bridge" 2>/dev/null
kill_if "bridge.py" "twin bridge"
pkill -x rviz 2>/dev/null
stopped="$stopped 桥 RViz"

# ---- 7) PX4 ----
if [ "$KEEPPX4" = "0" ]; then
  say "[7/8] 停 PX4 ..."
  tmux kill-session -t px4 2>/dev/null
  kill_if "bin/px4" "bin/px4"
  kill_if "px4_sitl_default" "px4_sitl"
  stopped="$stopped PX4"
else
  say "[7/8] 保留 PX4（--keep-px4）"
fi

# ---- 8) ROS master（默认保留）----
if [ "$ALL" = "1" ]; then
  say "[8/8] 停 ROS master（--all, 端口 $MASTER_PORT）..."
  pkill -f "rosmaster --core -p $MASTER_PORT" 2>/dev/null
  pkill -f "rosout" 2>/dev/null
  stopped="$stopped master"
  sleep 1
else
  say "[8/8] 保留 ROS master 常驻（要全停加 --all）"
fi

# ---- 收尾核对 ----
say ""
say "已停:${stopped:-（无）}"
say ""
say "残留检查:"
for p in fsm_node super_to_px4_bridge exploration_node traj_server goal_arbiter mavros fastlivo_mapping; do
  n=$(pgrep -f "$p" 2>/dev/null | wc -l)
  [ "$n" -gt 0 ] && say "  [!] $p 仍在跑 ($n)" || say "  [OK] $p 已停"
done
say ""
say "提示: PCD 在 $ROOT/Log/pcd/（仅当启动时传了参数 1）"
say "      下次启动: bash ~/super_explore_all.sh 1"
