<launch>
    <!-- This node will launch frame conversion from vision pose (tf) to mavros pose -->
    <node pkg="task_run_scripts" type="slam_to_mavros_node" name="tf_to_mavros" output="screen" >
        <param name="target_frame_id" value="/map" />
        <param name="source_frame_id" value="/base_link" />
        <param name="output_rate" value="30" />
        <remap from="slam_pose" to="/mavros/vision_pose/pose" />
    </node>
</launch>
